{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 5am on monday"
  ],
  "minimumReleaseAge": "7 days",
  "assignees": [
    "dtorannpu"
  ],
  "packageRules": [
    {
      "description": "Group TypeSpec libraries",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@typespec/**"
      ],
      "groupName": "typespec-libs"
    }
  ]
}
